#!/bin/sh
# Block commits containing secrets, server IPs, email addresses or .pem names.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not installed (brew install gitleaks); refusing to commit." >&2
  exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner --verbose \
  --config "$(git rev-parse --show-toplevel)/.gitleaks.toml"
