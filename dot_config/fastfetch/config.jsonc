// fastfetch — minimal, Vesper colours
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color": { "1": "38;2;255;199;153" },
    "padding": { "top": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;255;199;153", "title": "38;2;153;255;228" },
    "key": { "width": 8 }
  },
  "modules": [
    "break",
    "title",
    { "type": "os",       "key": "os" },
    { "type": "host",     "key": "host" },
    { "type": "uptime",   "key": "up" },
    { "type": "packages", "key": "pkgs" },
    { "type": "shell",    "key": "shell" },
    { "type": "terminal", "key": "term" },
    { "type": "terminalfont", "key": "font" },
    { "type": "cpu",      "key": "cpu" },
    { "type": "memory",   "key": "mem" },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
